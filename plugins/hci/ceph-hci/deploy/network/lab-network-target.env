VYOS01_WAN_GW="${VYOS01_WAN_GW:-192.168.68.1}"
VYOS01_TRUNK_PG="${VYOS01_TRUNK_PG:-router-vlan11-30-trunk}"
# Platform VLAN gateways: 10.0.<vlan>.1 on vyos01 (VLAN 11–30); VLAN 10 gateway stays Foreman .1
VYOS01_PLATFORM_VLAN_MIN="${VYOS01_PLATFORM_VLAN_MIN:-11}"
VYOS01_PLATFORM_VLAN_MAX="${VYOS01_PLATFORM_VLAN_MAX:-30}"

PROXY01_PROV_IP="${PROXY01_PROV_IP:-10.0.10.19}"

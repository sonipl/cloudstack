# Lab network target — single source of truth (Lab Network Redesign Plan)
# Source from scripts: . "$(dirname "$0")/lab-network-target.env" or deploy/network/lab-network-target.env

# --- Management LAN (iDRAC + ESXi mgmt + switch UI) ---

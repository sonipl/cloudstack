LAB_HOME_PREFIX="22"
LAB_HOME_GW="${LAB_HOME_GW:-192.168.68.1}"
LAB_HOME_DNS="${LAB_HOME_DNS:-192.168.71.22}"
LDAP01_MGMT_IP="${LDAP01_MGMT_IP:-10.0.10.16}"
DEVOPS01_MGMT_IP="${DEVOPS01_MGMT_IP:-10.0.10.17}"
VM01_MGMT_IP="${VM01_MGMT_IP:-10.0.10.18}"
IDRAC_MGMT_MASK="${IDRAC_MGMT_MASK:-255.255.252.0}"

# --- Migration status (2026-07-25) — ESXi + vc01 on home/mgmt 192.168.68.0/22 ---
# vc01: on pve05 localds-pve05, PG "VM Network" (untagged) — 192.168.71.20/22 (GW 192.168.68.1, DNS 192.168.71.22).
# vCenter API: GOVC_URL=https://vc01.vmalpha.com (A=192.168.71.20) administrator@vsphere.local.
# ESXi mgmt: pve03–05 at 192.168.71.13/.14/.15 (vmk0).
# SW01/SW02 still 192.168.71.11/.12.
# Mac admin: route 192.168.71.0/24 (and /22 as needed) via home router — see deploy/MIGRATION-STATUS.md.
MIGRATION_PHASE="${MIGRATION_PHASE:-home-mgmt}"
VC01_MGMT_IP_CURRENT="${VC01_MGMT_IP_CURRENT:-192.168.71.20}"
FOREMAN_MGMT_IP_CURRENT="${FOREMAN_MGMT_IP_CURRENT:-192.168.71.22}"
FOREMAN_PROV_IP_CURRENT="${FOREMAN_PROV_IP_CURRENT:-10.0.10.1}"
AC01_PROV_IP_CURRENT="${AC01_PROV_IP_CURRENT:-10.0.10.26}"

# Legacy ESXi/vCenter mgmt (pre VLAN10 cutover)
LEGACY_VC01_MGMT_IP="${LEGACY_VC01_MGMT_IP:-192.168.71.41}"
LEGACY_PVE03_ESXI_IP="${LEGACY_PVE03_ESXI_IP:-192.168.71.23}"
LEGACY_PVE04_ESXI_IP="${LEGACY_PVE04_ESXI_IP:-192.168.71.24}"
LEGACY_PVE05_ESXI_IP="${LEGACY_PVE05_ESXI_IP:-192.168.71.25}"

# --- vyos01 virtual router (vCenter VM) ---
VYOS01_VM_NAME="${VYOS01_VM_NAME:-vyos01}"
VYOS01_PROV_IP="${VYOS01_PROV_IP:-10.0.10.3}"
VYOS01_WAN_IP="${VYOS01_WAN_IP:-192.168.71.27}"

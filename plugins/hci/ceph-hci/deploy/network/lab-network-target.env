IDRAC_PVE04_CURRENT="${IDRAC_PVE04_CURRENT:-192.168.71.34}"
IDRAC_PVE05_CURRENT="${IDRAC_PVE05_CURRENT:-192.168.71.35}"
IDRAC_USER="${IDRAC_USER:-root}"
IDRAC_PASS="${IDRAC_PASS:-nayapl7674}"

# ESXi management — live on home/mgmt LAN (user cutover 2026-07-25)
PVE03_ESXI_IP="${PVE03_ESXI_IP:-192.168.71.13}"
PVE04_ESXI_IP="${PVE04_ESXI_IP:-192.168.71.14}"
PVE05_ESXI_IP="${PVE05_ESXI_IP:-192.168.71.15}"

# Aliases for scripts expecting HOME_PVE* (ESXi mgmt)
HOME_PVE03="${HOME_PVE03:-${PVE03_ESXI_IP}}"
HOME_PVE04="${HOME_PVE04:-${PVE04_ESXI_IP}}"
HOME_PVE05="${HOME_PVE05:-${PVE05_ESXI_IP}}"

# --- Provisioning LAN (VLAN 10 on host bonds) ---
LAB_PROV_NET="10.0.10.0/24"
LAB_PROV_PREFIX="24"
LAB_PROV_VLAN="10"
LAB_PROV_GW="${LAB_PROV_GW:-10.0.10.1}"  # Foreman bond1.10 router
LAB_PROV_DNS="${LAB_PROV_DNS:-10.0.10.1}"
LAB_PROV_PXE_NEXT_SERVER="${LAB_PROV_PXE_NEXT_SERVER:-0a:00:0a:01}"

# Host prov IPs (VLAN 10)
PVE01_PROV_IP="${PVE01_PROV_IP:-10.0.10.2}"
FOREMAN_PROV_IP="${FOREMAN_PROV_IP:-10.0.10.1}"
FOREMAN_HOME_IP="${FOREMAN_HOME_IP:-192.168.71.22}"
# ESXi is on home/mgmt 192.168.71.13–15 (see PVE0x_ESXI_IP). No separate 10.0.10.x ESXi mgmt.
PVE03_PROV_IP="${PVE03_PROV_IP:-}"
PVE04_PROV_IP="${PVE04_PROV_IP:-}"
PVE05_PROV_IP="${PVE05_PROV_IP:-}"

# Static infra / VMs on prov (.6-.12)
PROV_STATIC_BLOCK="10.0.10.6-10.0.10.12"
# vc01 now on home/mgmt LAN (192.168.68.0/22); keep PROV var as mgmt IP for DNS/scripts
VC01_PROV_IP="${VC01_PROV_IP:-192.168.71.20}"
VC01_MGMT_IP="${VC01_MGMT_IP:-192.168.71.20}"
VC01_MGMT_GW="${VC01_MGMT_GW:-192.168.68.1}"
VC01_MGMT_DNS="${VC01_MGMT_DNS:-192.168.71.22}"
VC01_MGMT_MASK="${VC01_MGMT_MASK:-255.255.252.0}"
VC02_PROV_IP="${VC02_PROV_IP:-10.0.10.12}"

# oel9 VLAN10 lab VMs (avoid vc01/vc02 .11/.12)
OEL9_V10_11_IP="${OEL9_V10_11_IP:-10.0.10.111}"
OEL9_V10_12_IP="${OEL9_V10_12_IP:-10.0.10.112}"

# Prov static core (migrate from 192.168.71.x)
LDAP01_PROV_IP="${LDAP01_PROV_IP:-10.0.10.16}"
DEVOPS01_PROV_IP="${DEVOPS01_PROV_IP:-10.0.10.17}"
VM01_PROV_IP="${VM01_PROV_IP:-10.0.10.18}"
SW01_PROV_IP="${SW01_PROV_IP:-10.0.10.13}"
SW02_PROV_IP="${SW02_PROV_IP:-10.0.10.14}"
AC01_PROV_IP="${AC01_PROV_IP:-10.0.10.6}"
LAB_PROV_GW_AC01="${LAB_PROV_GW_AC01:-10.0.10.1}"

PROV_DHCP_POOL_FROM="${PROV_DHCP_POOL_FROM:-10.0.10.101}"
PROV_DHCP_POOL_TO="${PROV_DHCP_POOL_TO:-10.0.10.252}"

# --- VLAN design (TL-SG108E) — Table 1 baseline (verified 2026-07-31, lab working) ---
# Record: deploy/network/SW01-SW02-PORTS.md (+ .csv / .xlsx)
# Apply:  bash deploy/network/setup-tplink-lab-vlans.sh --apply-table1
SW_LAYOUT="${SW_LAYOUT:-table1}"
VLAN_HOME_NATIVE="1"
VLAN_PRIVATE="${VLAN_PRIVATE:-1500}"
VLAN_INTERNET="9"   # unused in Table 1 (kept for legacy scripts)
VLAN_PROV="${LAB_PROV_VLAN}"
VLAN_TRUNK_MIN="10"
VLAN_TRUNK_MAX="30"
# Table 1: ports 1-4 hybrid U1+T10-30 PVID1; 5-7 access V1500; port 8 access U1
SW_TRUNK_PORTS="1 2 3 4"
SW_TRUNK_UNTAG_VLAN="1"
SW_TRUNK_TAG_VLANS="10-30"
SW_TRUNK_PVID="1"
SW_PRIVATE_PORTS="5 6 7"
SW_PRIVATE_VLAN="${VLAN_PRIVATE}"
SW_UPLINK_PORTS="8"
SW_UPLINK_VLAN="1"
# Legacy port maps (do not apply against live lab unless intentionally reverting)
SW_ACCESS_VLAN9_PORTS=""
SW_ALL_VLAN_PORTS="8"

# --- Legacy (migration reference) ---
LEGACY_HOME_NET="192.168.68.0/22"
LEGACY_FOREMAN_HOME="192.168.68.102"
LEGACY_PROV_NET="10.0.0.0/24"
LEGACY_SW01_MGMT="192.168.70.111"
LEGACY_SW02_MGMT="192.168.70.112"

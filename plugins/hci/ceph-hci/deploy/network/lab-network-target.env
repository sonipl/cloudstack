SW02_MGMT_IP_CURRENT="${SW02_MGMT_IP_CURRENT:-192.168.71.12}"
SW_USER="${SW_USER:-admin}"
SW_PASS="${SW_PASS:-Jatin76monu}"

# iDRAC — live (user-confirmed 2026-07-04)
IDRAC_PVE03="${IDRAC_PVE03:-192.168.71.33}"
IDRAC_PVE04="${IDRAC_PVE04:-192.168.71.34}"
IDRAC_PVE05="${IDRAC_PVE05:-192.168.71.35}"

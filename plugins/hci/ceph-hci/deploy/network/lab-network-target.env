LEGACY_HOME_PVE03="192.168.68.103"
LEGACY_HOME_PVE04="192.168.68.104"
LEGACY_HOME_PVE05="192.168.68.105"

# Mac admin: route 192.168.71.0/24 via home router when not on Foreman
MAC_ROUTE_MGMT_NET="${LAB_MGMT_NET}"
MAC_ROUTE_VIA="${MAC_ROUTE_VIA:-192.168.68.1}"

# VMware VMs on mgmt-Network / home LAN (192.168.68.0/22)
